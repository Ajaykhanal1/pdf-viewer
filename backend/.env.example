# Copy these values into your shell environment before starting Django.
# Django only reads environment variables; this file is documentation, not auto-loaded.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
APP_API_KEY=replace-with-the-same-key-used-in-frontend-src-api-config-ts
MAX_PDF_SIZE_MB=25
